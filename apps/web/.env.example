# Porta do Vite em dev (evita colisão com outro projecto na 5173, ex. Salux). Omitir = 5173.
# VITE_DEV_SERVER_PORT=5180

# URL base da API Flask (sem trailing slash)
# Deixe vazio em dev (usa o proxy do Vite automaticamente)
# Em produção aponte para o servidor Flask
VITE_API_BASE=

# Opcional em dev: forçar destino do proxy /api (ex. http://127.0.0.1:8081)
# VITE_DEV_API_TARGET=

# Se o feed MJPEG não carregar de outro host na rede, aponte para o Flask:
# VITE_VIDEO_FEED_ORIGIN=http://IP_DA_MAQUINA:8081

# Timeout do primeiro frame do feed (ms); após isso mostra erro em vez de spinner infinito
# VITE_VIDEO_FEED_LOAD_TIMEOUT_MS=120000

# Intervalo do poller /api/stats (ms, minimo 1500; default 3000 — menos travas na UI)
# VITE_STATS_POLL_MS=4000
