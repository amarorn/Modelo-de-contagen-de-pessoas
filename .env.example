# # Ultralytics HUB
# ULTRALYTICS_HUB_API_KEY=ul_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# # Projeto/experimento (opcional)
# ULTRALYTICS_PLATFORM_PROJECT=runs/people_count
# ULTRALYTICS_PLATFORM_NAME=yolov8m-door-counter

# # Hiperparametros de treino (opcional)
# YOLO_MODEL=yolov8m.pt
# YOLO_DATA_CONFIG=configs/dataset.yaml
# YOLO_EPOCHS=120
# YOLO_IMGSZ=640
# YOLO_BATCH=16
# YOLO_DEVICE=auto
# YOLO_WORKERS=8
# YOLO_PATIENCE=30
# YOLO_CLOSE_MOSAIC=10
# Treinar so classes com estes indices no YAML do dataset (virgula). COCO 80: person=0.
# YOLO_CLASSES=0

# # Inferencia (conf mais baixo e imgsz maior ajudam cenas noturnas / pessoas pequenas)
# YOLO_INFER_MODEL=runs/detect/amaro-neto/count_person/yolov8m-door-counter4/weights/best.pt
# YOLO_INFER_CONF=0.22
# Opcional scripts/run_web.sh: limiar so para o dashboard (ex. webcam com scores baixos). Omisso = YOLO_INFER_CONF.
# YOLO_WEB_INFER_CONF=0.02
# YOLO_INFER_IMGSZ=1280
# YOLO_INFER_IOU=0.5
# YOLO_MAX_DET=200
# YOLO_AUGMENT=0
# YOLO_AGNOSTIC_NMS=0
# # Web dashboard: forcar GPU (auto = primeira CUDA). FP16 na CUDA por defeito; YOLO_NO_HALF=1 usa FP32.
# # YOLO_DEVICE=0
# # YOLO_NO_HALF=0
# # YOLO_VID_STRIDE=2
# # YOLO_STREAM_BUFFER=1
# COUNT_LINE=960,300,960,900
# # Se vazio, o script tenta encontrar a classe "person" pelo nome no modelo.
# PERSON_CLASS_ID=
# # CSV de resumo final da contagem (se vazio, gera automaticamente em outputs/)
# COUNT_CSV_OUT=outputs/count_summary.csv

# # Dashboard web
# # Camera local / ficheiro / RTSP / URL HLS direto:
# YOLO_WEB_SOURCE=0
# # Live YouTube (ex. Fremont): ./scripts/run_web.sh --youtube 'URL' ou defina:
# # YOLO_WEB_YOUTUBE_URL=https://www.youtube.com/watch?v=ZvYvZLfPatQ
# # Requer: .venv/bin/pip install -U yt-dlp. Para 1280x720 use linha em pixels, ex.:
# # COUNT_LINE=640,200,640,520
# WEB_HOST=0.0.0.0
# WEB_PORT=8080
# WEB_MOBILE_PORT=8081
# MOBILE_COUNT_LINE=0.5,0.3,0.5,0.9
# Limiar conf so para scripts/run_web_mobile.sh (omissao no script ~0.02). Suba se FP; baixe se nao aparecer caixa.
# YOLO_MOBILE_INFER_CONF=0.02
# # Mapa de calor (agregado, sem identidade). WEB_HEATMAP=0 desliga.
# WEB_HEATMAP=1
# HEAT_SCALE=4
# HEAT_DECAY=0.985
# HEAT_RADIUS=10
# HEAT_ALPHA=0.42
# HEAT_GAIN=1.0


# # Ultralytics HUB
# ULTRALYTICS_HUB_API_KEY=ul_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# # Projeto/experimento (opcional)
# ULTRALYTICS_PLATFORM_PROJECT=runs/people_count
# ULTRALYTICS_PLATFORM_NAME=yolov8m-door-counter

# # Hiperparametros de treino (opcional)
# YOLO_MODEL=yolov8m.pt
# YOLO_DATA_CONFIG=configs/dataset.yaml
# YOLO_EPOCHS=120
# YOLO_IMGSZ=640
# YOLO_BATCH=16
# YOLO_DEVICE=auto
# YOLO_WORKERS=8
# YOLO_PATIENCE=30
# YOLO_CLOSE_MOSAIC=10
# Treinar so classes com estes indices no YAML do dataset (virgula). COCO 80: person=0.
# YOLO_CLASSES=0

# # Inferencia (conf mais baixo e imgsz maior ajudam cenas noturnas / pessoas pequenas)
# YOLO_INFER_MODEL=runs/detect/amaro-neto/count_person/yolov8m-door-counter4/weights/best.pt
# YOLO_INFER_CONF=0.22
# Opcional scripts/run_web.sh: limiar so para o dashboard (ex. webcam com scores baixos). Omisso = YOLO_INFER_CONF.
# YOLO_WEB_INFER_CONF=0.02
# YOLO_INFER_IMGSZ=1280
# YOLO_INFER_IOU=0.5
# YOLO_MAX_DET=200
# YOLO_AUGMENT=0
# YOLO_AGNOSTIC_NMS=0
# # Web dashboard: forcar GPU (auto = primeira CUDA). FP16 na CUDA por defeito; YOLO_NO_HALF=1 usa FP32.
# # YOLO_DEVICE=0
# # YOLO_NO_HALF=0
# # YOLO_VID_STRIDE=2
# # YOLO_STREAM_BUFFER=1
# COUNT_LINE=960,300,960,900
# # Se vazio, o script tenta encontrar a classe "person" pelo nome no modelo.
# PERSON_CLASS_ID=
# # CSV de resumo final da contagem (se vazio, gera automaticamente em outputs/)
# COUNT_CSV_OUT=outputs/count_summary.csv

# # Dashboard web
# # Camera local / ficheiro / RTSP / URL HLS direto:
# YOLO_WEB_SOURCE=0
# # Live YouTube (ex. Fremont): ./scripts/run_web.sh --youtube 'URL' ou defina:
# # YOLO_WEB_YOUTUBE_URL=https://www.youtube.com/watch?v=ZvYvZLfPatQ
# # Requer: .venv/bin/pip install -U yt-dlp. Para 1280x720 use linha em pixels, ex.:
# # COUNT_LINE=640,200,640,520
# WEB_HOST=0.0.0.0
# WEB_PORT=8080
# WEB_MOBILE_PORT=8081
# MOBILE_COUNT_LINE=0.5,0.3,0.5,0.9
# Limiar conf so para scripts/run_web_mobile.sh (omissao no script ~0.02). Suba se FP; baixe se nao aparecer caixa.
# YOLO_MOBILE_INFER_CONF=0.02
# # Mapa de calor (agregado, sem identidade). WEB_HEATMAP=0 desliga.
# WEB_HEATMAP=1
# HEAT_SCALE=4
# HEAT_DECAY=0.985
# HEAT_RADIUS=10
# HEAT_ALPHA=0.42
# HEAT_GAIN=1.0


# -----------------------------------------------------------------------------
# Ultralytics Platform (opcional)
# -----------------------------------------------------------------------------
ULTRALYTICS_HUB_API_KEY=ul_10d3f921e0831b3c99038154e4986a40502d5277
ULTRALYTICS_PLATFORM_PROJECT=amaro-neto/count_person
ULTRALYTICS_PLATFORM_PROJECT_NAME=amaro-neto
ULTRALYTICS_PLATFORM_NAME=
# Modelo: caminho relativo a este repo ou absoluto nesta maquina (evite paths de outro OS).
# YOLO_INFER_MODEL=runs/detect/amaro-neto/count_person/yolov8m-door-counter4/weights/best.pt
ULTRALYTICS_PLATFORM_URL=https://platform.ultralytics.com
ULTRALYTICS_DATASET_SLUG=construction-ppe
ULTRALYTICS_UPLOAD_SAMPLE_PCT=100
#ULTRALYTICS_DATASET_ID= # dataset id do projeto Engefoto v
ULTRALYTICS_CA_BUNDLE=
ULTRALYTICS_SSL_VERIFY=0
# ID da classe "pessoa" no SEU modelo (veja log ao iniciar: classe filtrada id=...). COCO padrao: 0. Deixe vazio para resolver pelo nome "person".
PERSON_CLASS_ID=6


# NOGROK_AUTHTOKEN=coloque_o_token_do_ngrok_aqui

# Deteccao: imgsz maior ajuda pessoas pequenas; conf muito baixo aumenta falso positivo
YOLO_INFER_CONF=0.15
# Com "so veiculos" na UI: multiplica a conf (ex. 0.55 * YOLO_INFER_CONF) para noite/reflexos; 1 = sem ajuste
# YOLO_CONF_MULT_VEHICLE_ONLY=0.55
YOLO_INFER_IMGSZ=1280
YOLO_INFER_IOU=0.45
YOLO_MAX_DET=250
# YOLO_AUGMENT=1 deixa mais lento mas pode ajudar noite/contraste (teste se tiver GPU)
YOLO_AUGMENT=0
YOLO_AGNOSTIC_NMS=0
# Stream web: stride>=2 alivia CPU/GPU; use 1 se a contagem por cruzamento falhar (IDs mais estaveis).
# YOLO_VID_STRIDE=2
# YOLO_STREAM_BUFFER=0 (menor latencia HLS; 1 = fila se aparecer "Waiting for stream")
# FFmpeg/OpenCV (export antes do Python; run_web.sh define defeito). Ex. RTSP: OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp
# YOLO_STREAM_BUFFER
# Linha em pixels (x1,y1,x2,y2); os pes cruzam a linha. Ajuste a resolucao real do video.
# COUNT_LINE=640,50,640,700
# Menos piscar nas caixas: EMA + manter bbox sem deteccao; tracker com buffer maior opcional
# YOLO_TRACKER=configs/bytetrack_stable.yaml
# YOLO_TRACK_EMA=0.3
# YOLO_TRACK_HOLD_FRAMES=30
# Historico do trajeto (pes) por pessoa no video; 0 desliga a linha
# YOLO_WEB_TRAIL_LEN=72
# Seta de tendencia de movimento (PCA no rastro): 1=ligado, 0=desliga
# YOLO_WEB_HEADING=1
# Filtro de forma: corta postes finos, placas horizontais e caixas enormes (falsos "person")
# YOLO_NO_SHAPE_FILTER=1
# YOLO_MIN_PERSON_AR=0.85
# YOLO_MAX_PERSON_AR=4.0
# YOLO_MAX_BOX_AREA_FRAC=0.14
# YOLO_MIN_PERSON_HEIGHT_PX=28
# Classificador agregado (YOLO classify .pt); classes female/male ou mulher/homem; ver docs/04_privacidade_etica.md
# Dataset Platform: gender-classifierv1 (gender-classifierv1.ndjson); experimento: classification-exp-4
# Copie o .pt exportado para weights/gender-classifier/classification-exp-4.pt — ver configs/gender_classifier.yaml
# YOLO_SEX_MODEL=weights/gender-classifier/classification-exp-4.pt
# YOLO_SEX_ABSTAIN=0.55
# Janela de votacao por track (dashboard + mobile); min votos para F ou M (senao "?").
# YOLO_SEX_SMOOTH_WINDOW=9
# YOLO_SEX_SMOOTH_MIN=5
# Tamanho da imagem na inferencia classify (224-384). Mais alto = mais nitido, mais GPU.
# YOLO_SEX_CLASSIFY_IMGSZ=288
# Margem extra no recorte da bbox (0-0.35).
# YOLO_SEX_CROP_PAD=0.08
# Vista de cima / camara longe: bbox baixa em px; classificador erra — so classificar se altura bbox >= N (0 = off).
# YOLO_SEX_MIN_BOX_HEIGHT_PX=160
# Faixa etaria (opcional): modelo YOLO classify com classes nomeadas p.ex. child/teen/young/adult/elderly ou PT
# YOLO_AGE_MODEL=runs/age_classify/weights/best.pt
# YOLO_AGE_ABSTAIN=0.55

# Mapa de calor: rastro mais longo + mais forte onde muita gente passa (reinicie o run_web.sh)
WEB_HEATMAP=1
HEAT_SCALE=3
HEAT_DECAY=0.993
HEAT_RADIUS=14
HEAT_ALPHA=0.48
HEAT_GAIN=1.75

# =============================================================================
# Modelo de contagem de pessoas — variaveis de ambiente
# Carregado por scripts/run_web.sh e run_web_mobile.sh. Reinicie o servidor apos editar.
# =============================================================================

# =============================================================================
# 1. GPU e precisao
# =============================================================================
# 0 = primeira GPU; auto = escolha automatica. YOLO_NO_HALF=1 forca FP32 (mais lento).
YOLO_DEVICE=0
YOLO_NO_HALF=0

# =============================================================================
# 2. Modelo de deteccao (pessoas) e classe
# =============================================================================
YOLO_INFER_MODEL=/home/amaro-neto/Modelo-de-contagen-de-pessoas/runs/detect/amaro-neto/count_person/yolov8m-door-counter11/weights/best-11.pt
# Indice da classe "pessoa" no modelo (0 = Pessoa / COCO person). ID errado = zero deteccoes.
PERSON_CLASS_ID=0
# Varias classes (ex.: pessoa+carro): IDs separados por virgula. Omisso = so a classe pessoa.
# COUNT_CLASS_IDS=0,1

# =============================================================================
# 3. Inferencia YOLO (dashboard / stream)
# =============================================================================
# Limiar de confianca (dashboard). Webcam local: ver YOLO_WEB_INFER_CONF abaixo.
YOLO_INFER_CONF=0.25
# Opcional: limiar so para run_web.sh com webcam (ex. 0.02). Descomente se precisar.
# YOLO_WEB_INFER_CONF=0.02
YOLO_MIN_DET_CONF=0.15
YOLO_INFER_IMGSZ=1280
YOLO_INFER_IOU=0.70
YOLO_MAX_DET=600
YOLO_AUGMENT=0
YOLO_AGNOSTIC_NMS=0
# Stride 1 = cada frame. 2/3 = mais FPS, menos frames. Valor 0 no .env vira 1 no codigo.
YOLO_VID_STRIDE=1
# 0 = menor latencia; 1 = fila se aparecer "Waiting for stream".
YOLO_STREAM_BUFFER=1

# Qualidade de contagem (track confidence 6.1): score composto YOLO + estabilidade do bbox + idade do track.
# Cruzamentos com score abaixo do limiar nao entram nos contadores (ver suppressed_events no /api/stats).
# TRACK_CONF_SUPPRESS_THRESHOLD=0.35
# TRACK_CONF_MIN_AGE_FRAMES=3

# Drift de câmara (6.3), posição: score = (MAD - baseline_MAD) / (baseline_MAD * MAD_FRAC).
# CAM_DRIFT_POSITION_THRESHOLD=0.45   — alerta se score >= isto (subir p.ex. 0.65 reduz alertas).
# CAM_DRIFT_POSITION_MAD_FRAC=0.12    — omisso; subir (1.0–2.5) em cenas cheias para o score não ficar sempre 100%.

# =============================================================================
# 4. Webcam mobile (run_web_mobile.sh) — conf separada do dashboard
# =============================================================================
# Abaixo de ~0.25 costuma haver caixas na webcam; 0.25 aqui remove quase tudo.
YOLO_MOBILE_INFER_CONF=0.02

# =============================================================================
# 5. Linha virtual de contagem (pixels no frame; ex. 1280x720)
# =============================================================================
# Ajuste no browser ("Calibrar linha") ou poligono /roi. Mobile: MOBILE_COUNT_LINE no .env.example.
COUNT_LINE=640,50,640,700

# =============================================================================
# 6. Tracking (ByteTrack)
# =============================================================================
YOLO_TRACKER=configs/bytetrack_live.yaml
YOLO_TRACK_EMA=0.45
YOLO_TRACK_HOLD_FRAMES=1
YOLO_HIDE_STALE_BOXES=1

# =============================================================================
# 7. Filtros geometricos (bbox pessoa)
# =============================================================================
YOLO_NO_SHAPE_FILTER=1
YOLO_MIN_PERSON_AR=0.98
YOLO_MAX_PERSON_AR=3.6
YOLO_MAX_BOX_AREA_FRAC=0.12
YOLO_MIN_PERSON_HEIGHT_PX=42

# =============================================================================
# 8. Classificador de sexo (YOLO classify; opcional)
# =============================================================================
# Deteccao = best.pt acima. Sexo = ficheiro task=classify (Female/Male). Vazio = desativado.
YOLO_SEX_MODEL=/home/amaro-neto/Modelo-de-contagen-de-pessoas/runs/detect/amaro-neto/count_person/yolov8m-door-counter11/weights/exp-sex-1.pt
# Confianca minima top-1; abaixo = incerto. Subir se FP; baixar se tudo "?".
YOLO_SEX_ABSTAIN=0.55
# Suavizacao temporal (dashboard + mobile). Desativar efeito: YOLO_SEX_SMOOTH_WINDOW=1
# YOLO_SEX_SMOOTH_WINDOW=9
# YOLO_SEX_SMOOTH_MIN=5
# YOLO_SEX_CLASSIFY_IMGSZ=288
# YOLO_SEX_CROP_PAD=0.08
# YOLO_SEX_MIN_BOX_HEIGHT_PX=0

# =============================================================================
# 9. Classificador de idade (YOLO classify; opcional)
# =============================================================================
YOLO_AGE_MODEL=runs/age_classify/weights/best.pt
YOLO_AGE_ABSTAIN=0.55

# =============================================================================
# 10. Fonte de video e OpenCV + FFmpeg
# =============================================================================
OPENCV_FFMPEG_CAPTURE_OPTIONS=fflags;nobuffer|max_delay;500000
# HLS (https://...m3u8): o arranque junta user_agent e referer ao site (mesmo que no browser). Se o Ultralytics
# falhar com "Failed to read images from ...URL", o manifesto pode ter expirado — copie um chunks.m3u8 novo
# (Ferramentas de rede no navegador) ou abra de novo a pagina do player.
# Skyline: o token ?a= expira; exemplos m3u8 abaixo deixam de abrir ao fim de pouco tempo. Prefira URL .html (linha seguinte comentada).
YOLO_WEB_SOURCE=https://hd-auth.skylinewebcams.com/live.m3u8?a=gs84ak06id487cjgru7qeednl1
YOLO_WEB_SOURCE_PRESETS=[{"id":"sky-1","label":"Skyline (m3u8)","url":"https://hd-auth.skylinewebcams.com/live.m3u8?a=dpcp0gh54eia46tcq5ip94gck7"}]
# DVR Intelbras (exemplo): comente Skyline acima e descomente as linhas abaixo.
# OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp|fflags;nobuffer|max_delay;500000
# YOLO_WEB_SOURCE=rtsp://user:258258@192.168.20.220:554/cam/realmonitor?channel=1&subtype=1
# YOLO_WEB_SOURCE_PRESETS=[{"id":"dvr-ch1","label":"Intelbras CH1","url":"rtsp://user:258258@192.168.20.220:554/cam/realmonitor?channel=1&subtype=1"},{"id":"dvr-ch2","label":"Intelbras CH2","url":"rtsp://user:258258@192.168.20.220:554/cam/realmonitor?channel=2&subtype=1"},{"id":"dvr-ch3","label":"Intelbras CH3","url":"rtsp://user:258258@192.168.20.220:554/cam/realmonitor?channel=3&subtype=1"}]
# Pagina .html Skyline: YOLO_WEB_SOURCE=https://www.skylinewebcams.com/.../webcam/....html
FFMPEG_RELAY=1
# FFMPEG_STATIC_DIR=/caminho/para/pasta_com_ffmpeg_e_ffprobe

# =============================================================================
# 11. Servidor web e MJPEG
# =============================================================================
# WEB_HOST=0.0.0.0
# WEB_PORT=8080
# WEB_MOBILE_PORT=8081
YOLO_WEB_PREVIEW_MAX_WIDTH=1280
YOLO_WEB_JPEG_QUALITY=75
YOLO_WEB_TRAIL_LEN=72
YOLO_WEB_HEADING=1
CAP_PROP_BUFFERSIZE=1

# =============================================================================
# 12. Mapa de calor (WEB_HEATMAP=0 desliga no arranque)
# =============================================================================
WEB_HEATMAP=1
HEAT_SCALE=3
HEAT_DECAY=0.993
HEAT_RADIUS=14
HEAT_ALPHA=0.48
HEAT_GAIN=1.75

# =============================================================================
# 13. Processo de inferencia / display (X11)
# =============================================================================
INFER_NO_SHOW=1
# DISPLAY tipo :0 (X11). "1" nao e display valido.
DISPLAY=:1

# =============================================================================
# 14. MLOps e treino
# =============================================================================
INSTALL_MLOPS_DEPS=1
TRAIN_USE_MLFLOW=1

# =============================================================================
# 15. Ultralytics Platform (opcional)
# =============================================================================
ULTRALYTICS_HUB_API_KEY=ul_10d3f921e0831b3c99038154e4986a40502d5277
ULTRALYTICS_PLATFORM_PROJECT=amaro-neto/count_person
ULTRALYTICS_PLATFORM_PROJECT_NAME=amaro-neto
ULTRALYTICS_PLATFORM_NAME=
ULTRALYTICS_PLATFORM_URL=https://platform.ultralytics.com
ULTRALYTICS_DATASET_SLUG=construction-ppe
ULTRALYTICS_UPLOAD_SAMPLE_PCT=100
ULTRALYTICS_CA_BUNDLE=
ULTRALYTICS_SSL_VERIFY=0

# =============================================================================
# 16. Tunel / utilitarios
# =============================================================================
NOGROK_AUTHTOKEN=1Wka7bPItdP6S8gQPFyjXKPdOt1_3kwr75tLopH6ZTZnZU6Y3

# =============================================================================
# 17. Fase 3 — Hotspots (composite)
# =============================================================================
# HOTSPOT_RECENT_ALPHA=0.6
# HOTSPOT_RECENT_WINDOW_S=900
# HOTSPOT_HIST_DAYS=7
# HOTSPOT_HIST_CACHE_TTL_S=60
